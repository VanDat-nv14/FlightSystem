{
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver,1433;Database=FlightBookingDB;User Id=sa;Password=${DB_SA_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "JwtSettings": {
    "SecurityKey": "${JWT_SECURITY_KEY}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "ExpiryInMinutes": 60
  },
  "Google": {
    "ClientId": "${GOOGLE_CLIENT_ID}",
    "ClientSecret": "${GOOGLE_CLIENT_SECRET}"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "${SMTP_USERNAME}",
    "Password": "${SMTP_PASSWORD}",
    "FromName": "SkyBooking - Đặt Vé Máy Bay",
    "FromAddress": "${SMTP_USERNAME}"
  },
  "SeedData": {
    "AdminEmail": "${SEED_ADMIN_EMAIL}",
    "AdminPassword": "${SEED_ADMIN_PASSWORD}",
    "ManagerPassword": "${SEED_MANAGER_PASSWORD}"
  },
  "AllowedHosts": "*"
}
