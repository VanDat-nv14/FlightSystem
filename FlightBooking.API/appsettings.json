      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "SecurityKey": "SecurityKeyFromUserSecrets",
    "Issuer": "IssuerFromUserSecrets",
    "Audience": "AudienceFromUserSecrets",
    "ExpiryInMinutes": 60
  },
  "Google": {
    "ClientId": "ClientIdFromUserSecrets",
    "ClientSecret": "ClientSecretFromUserSecrets"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "your-email@gmail.com",
    "Password": "your-app-password",
    "FromName": "SkyBooking - Đặt Vé Máy Bay",
    "FromAddress": "no-reply@skybooking.vn"
  },
  "SeedData": {
    "AdminEmail": "admin@example.com",
    "AdminPassword": "PlaceholderPassword123!",
    "ManagerPassword": "PlaceholderPassword123!"
  },
  "AllowedHosts": "*"
